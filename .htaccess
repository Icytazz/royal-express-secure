# Defence in depth: the .env file should not be inside the document root at
# all, but while it is, deny HTTP access to it and to other sensitive files.

<FilesMatch "^\.(env|env\.example|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

# Do not advertise the directory listing of asset folders.
Options -Indexes

# Version disclosure
ServerSignature Off
